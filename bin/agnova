#!/usr/bin/env bash
# Thin wrapper for running agnova straight from a checkout, without installing.
#
# The real interface is the `agnova` console script (`pip install agnova`), which
# is what an agent repository consuming this as a dependency will have. This
# script exists only so a clone can be exercised in place; it deliberately adds
# no behaviour of its own, because two entry points that disagree is worse than
# one that is slightly less convenient.
#
#   bin/agnova up|down|restart|status|doctor|logs|selftest [agent]
#   bin/agnova install                 build the pinned upstream
#   bin/agnova upstream-check|upstream-update [ref]
set -euo pipefail
cd "$(dirname "$0")/.."
exec python3 -c 'import sys; sys.path.insert(0, "src"); from agnova.supervise import main; main()' "$@"
