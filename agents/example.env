# Template for a new agent. Copy to `agents/<name>.env` and edit.
#
#   cp agents/example.env agents/scout.env
#   export BUZZ_PRIVATE_KEY=<scout's own key>      # never Scout's, never committed
#   just up scout
#
# Provisioning a new identity is four steps, all on Buzz's side:
#
#   1. Keypair       `buzz-admin generate-key`, or Buzz Desktop's agent flow.
#   2. Relay member  claim an invite, or `buzz-admin add-member` with DB access.
#   3. Room access   the room owner runs, per room:
#                    buzz channels add-member --channel <UUID> --pubkey <agent> --role bot
#   4. Attestation   scripts/buzz-mint-auth-tag.py --agent <pubkey>, run by the
#                    OWNER with their key, then set the result as BUZZ_AUTH_TAG.
#
# The pubkey is always derived from the private key, never configured. A
# hardcoded pubkey that disagrees with the key is the nastiest bug available
# here: the agent stops recognising its own messages and answers itself forever.

BUZZ_AGENT_LABEL=Scout

# Who this agent answers, and who attests to it.
BUZZ_OWNER_PUBKEY=

# owner-only (default) | allowlist | anyone | nobody
BUZZ_ACP_RESPOND_TO=owner-only

# claude-agent-acp (Claude Code) | goose | codex-acp
BUZZ_ACP_AGENT_COMMAND=claude-agent-acp

# Where the agent's files live — its memory, skills and tools. A second agent
# in this checkout should get its own directory rather than sharing Scout's.
BUZZ_AGENT_HOME=.

# Each agent needs its own front door port when several run on one host.
BUZZ_FRONTDOOR_PORT=8444

BUZZ_ACP_AGENTS=1
BUZZ_ACP_HEARTBEAT_INTERVAL=0
